<launch>

    <arg name="project" default="cuda_rbf"/>
    
    <!-- Parameters -->
    <rosparam file="$(find cuda_rbf)/config/params.yaml" command="load" />

    <!--- LOAM -->
    <include file="$(find cuda_rbf)/launch/include/module_loam.launch" />

    <!--- Robot State TF -->
    <!-- <include file="$(find cuda_rbf)/launch/include/module_robot_state_publisher.launch" /> -->

    <!--- Run Navsat -->
    <!-- <include file="$(find cuda_rbf)/launch/include/module_navsat.launch" /> -->

    <!--- Run Rviz-->
    <include file="$(find cuda_rbf)/launch/include/module_rviz.launch" />

</launch>
